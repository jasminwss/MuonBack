executable = submitscript3.sh 

notify_user				= jasminvweiss@gmail.com
notification 			= Always

arguments = "$(inputFile) $(startEvent) $(nEvents) $(Process) $(Cluster)"

output      = logs/job_$(Cluster)_$(Process).out
error       = logs/job_$(Cluster)_$(Process).err
log         = logs/job_$(Cluster).log

# values as requested by the TRY6LiSc production (cluster 11921562, see its job log)
request_CPUs   = 2
request_memory = 6 GB
request_disk   = 5 GB

+JobFlavour = "tomorrow"

on_exit_remove   		= (ExitBySignal == False) && (ExitCode == 0)
max_retries      		= 3
requirements     		= Machine =!= LastRemoteHost 

# Ensure the job has access to your EOS/CVMFS credentials
requirements = (OpSysAndVer =?= "AlmaLinux9")
+REQUIRED_OS = "AlmaLinux9"
#use_x509userproxy = True

# TRY6LiSc full production used sim_jobs.txt (8255 jobs); sim_jobs_short.txt for tests
queue inputFile,startEvent,nEvents from sim_jobs_short.txt